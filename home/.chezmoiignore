# Repo-only files never applied to $HOME live outside home/ (see .chezmoiroot).
# herdr runtime files are never managed
.config/herdr/*.sock
.config/herdr/*.sock.agent
.config/herdr/*.log
.config/herdr/session.json
.config/herdr/sessions
.config/herdr/session-snapshots
.config/herdr/release-notes.json
.config/herdr/.plugins.lock
.config/glow/README.md
{{- if eq .chezmoi.os "darwin" }}
# macOS: glow reads ~/Library/Preferences/glow; Ghostty loads macos.ghostty
.config/glow/glow.yml
.config/ghostty/linux.ghostty
{{- else }}
# Linux: glow reads ~/.config/glow; Ghostty loads linux.ghostty
Library
.config/ghostty/macos.ghostty
{{- end }}
{{- if not (and (eq .chezmoi.os "linux") (eq (get . "terminal") "ptyxis")) }}
# The Ptyxis palette only where Ptyxis is the terminal (Linux, terminal = ptyxis)
.local/share/org.gnome.Ptyxis
{{- end }}
