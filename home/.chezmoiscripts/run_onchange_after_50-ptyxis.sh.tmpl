{{ if and (eq .chezmoi.os "linux") (eq (get . "terminal") "ptyxis") -}}
{{- $box := "ubuntu-dev" -}}
{{- $bazzite := eq (toString (get . "installTarget")) "distrobox" -}}
{{- $id := "" -}}
{{- if $bazzite -}}
{{-   $podman := "podman" }}{{ if get . "container" }}{{ $podman = "distrobox-host-exec podman" }}{{ end -}}
{{-   $id = output "sh" "-c" (printf "%s inspect %s --format '{{.Id}}' 2>/dev/null || true" $podman $box) | trim -}}
{{-   if not (regexMatch "^[0-9a-f]{64}$" $id) }}{{ $id = "" }}{{ end -}}
{{- end -}}
#!/bin/sh
# The Ptyxis settings we own. Everywhere: the default profile's palette (the catppuccin-mocha.palette
# chezmoi puts in ~/.local/share/org.gnome.Ptyxis/palettes). On Bazzite (installTarget = distrobox)
# also: the default profile is labelled Host and opens the host, and a separate profile labelled
# {{ $box }}, found by that label, opens the box's zsh login shell. Every other Ptyxis setting, the
# font included, is left alone. bin/drift reads the `own` lines and the `box_label=` and `by_label()` lines.
# Ptyxis and its GSettings schema exist only on the host, so in a distrobox gsettings runs there.
set -eu
{{ if get . "container" -}}
gs() { distrobox-host-exec gsettings "$@"; }
{{- else -}}
gs() { gsettings "$@"; }
{{- end }}
own() { gs set "$@"; }

if ! gs list-keys org.gnome.Ptyxis >/dev/null 2>&1; then
  echo "ptyxis: Ptyxis settings (org.gnome.Ptyxis) not found; palette not set; once Ptyxis is installed, run: chezmoi state delete-bucket --bucket=entryState && chezmoi apply" >&2
  exit 0
fi

uuid="$(gs get org.gnome.Ptyxis default-profile-uuid | tr -d "'")"
if [ -z "$uuid" ]; then
  echo "ptyxis: no default profile yet; open Ptyxis once, then run: chezmoi state delete-bucket --bucket=entryState && chezmoi apply" >&2
  exit 0
fi
{{- if and $bazzite $id }}
box_label='{{ $box }}'
by_label() { for u in $(gs get org.gnome.Ptyxis profile-uuids | sed 's/^@as //' | tr -d "[]',"); do if [ "$(gs get "org.gnome.Ptyxis.Profile:/org/gnome/Ptyxis/Profiles/$u/" label)" = "'$1'" ]; then echo "$u"; return 0; fi; done; return 0; }

new_profile() { # a new profile's uuid, added to profile-uuids (with the default, if that was missing)
  new="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
  uuids="$(gs get org.gnome.Ptyxis profile-uuids | sed 's/^@as //')"
  case "$uuids" in
    "[]"|"") uuids="['$uuid', '$new']" ;;
    *"'$uuid'"*) uuids="${uuids%]}, '$new']" ;;
    *) uuids="${uuids%]}, '$uuid', '$new']" ;;
  esac
  gs set org.gnome.Ptyxis profile-uuids "$uuids"
  echo "$new"
}

# The box profile is found by its label, never by being the default. Before this layout the default
# profile was the box and a separate Host profile opened the host; there the Host profile (or a new
# one) becomes the default, and the old default stays the box profile.
box="$(by_label "$box_label")"
if [ "$box" = "$uuid" ]; then
  host="$(by_label Host)"
  [ -n "$host" ] || host="$(new_profile)"
  gs set org.gnome.Ptyxis default-profile-uuid "'$host'"
  uuid="$host"
fi
[ -n "$box" ] || box="$(new_profile)"
{{- end }}
PROFILE="org.gnome.Ptyxis.Profile:/org/gnome/Ptyxis/Profiles/$uuid/"
own "$PROFILE" palette "'catppuccin-mocha'"
{{- if $bazzite }}
{{-   if $id }}
own "$PROFILE" label "'Host'"
own "$PROFILE" default-container "'session'"

# Box {{ $box }}, podman ID {{ $id }}, looked up when this rendered. Ptyxis needs the ID, not the
# name; a rebuild changes it, which changes this script, so the next apply runs it again.
BOX_PROFILE="org.gnome.Ptyxis.Profile:/org/gnome/Ptyxis/Profiles/$box/"
gs set "$BOX_PROFILE" default-container "'{{ $id }}'"
own "$BOX_PROFILE" label "'{{ $box }}'"
own "$BOX_PROFILE" palette "'catppuccin-mocha'"
# Ptyxis would run the host user's bash in the box; this is the box's zsh login shell.
own "$BOX_PROFILE" use-custom-command true
own "$BOX_PROFILE" custom-command "'/usr/bin/zsh -l'"
{{-   else }}

echo "ptyxis: box {{ $box }} not found; the default profile still opens the host. Once the box exists, run chezmoi apply again" >&2
{{-   end }}
{{- end }}
{{ end -}}
