{{- if ne (toString (get . "agentPlugins")) "false" -}}
#!/bin/sh
# Keep crew and its packs (lib/agent-plugins.txt) installed at user scope for Claude Code, Codex and
# pi, at the crew release pinned there. Runs on every apply, so a tool installed after the first apply
# gets them at the next one, and a re-pinned release (or a machine still on the old pixeloven/marketplace
# catalogue) moves at the next one. A plugin you disabled is never re-installed or updated.
# Opt a machine out with agentPlugins = false in ~/.config/chezmoi/chezmoi.toml.
set -eu
exec "{{ .chezmoi.workingTree }}/lib/agent-plugins.sh" ensure
{{ end -}}
