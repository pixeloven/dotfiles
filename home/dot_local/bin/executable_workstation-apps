#!/usr/bin/env bash
# Select optional apps independently of ops toolsets and the existing base Brewfile.
# Usage: workstation-apps list | plan [app...] | install [app...] | on <app>... | off <app>...
# on/off only change selection. install is explicit; off never uninstalls or removes app data.
set -euo pipefail
repo="${DOTFILES_APPS_REPO:-$(dirname "$(chezmoi source-path)")}"
config="${XDG_CONFIG_HOME:-$HOME/.config}/chezmoi/chezmoi.toml"
manager="$repo/lib/workstation-apps.sh"
cmd="${1:-plan}"; [ "$#" -eq 0 ] || shift
selection() {
  local raw
  raw="$("$repo/lib/toml-set.sh" --get "$config" data workstationApps)"
  [ -n "$raw" ] || return 0
  # Strict single-line array of IDs; never evaluate configuration as shell code.
  local array_re='^\[[[:space:]]*("[a-z0-9-]+"([[:space:]]*,[[:space:]]*"[a-z0-9-]+")*[[:space:]]*,?)?[[:space:]]*\]$'
  if [[ ! "$raw" =~ $array_re ]]; then
    echo "workstation-apps: workstationApps must be a single-line array of app IDs" >&2; return 2
  fi
  tr -d '[]"' <<<"$raw" | tr -d '[:space:]' | tr ',' '\n' | sed '/^$/d'
}
selected=()
raw="$(selection)"
while IFS= read -r item; do [ -z "$item" ] || selected+=("$item"); done <<<"$raw"
case "$cmd" in
  list) exec "$manager" list ;;
  plan|install)
    [ "$#" -gt 0 ] || set -- ${selected[@]+"${selected[@]}"}
    target="$("$repo/lib/toml-set.sh" --get "$config" data installTarget)"
    target="${target//\"/}"
    export DOTFILES_APPS_INSTALL_TARGET="${target:-host}"
    exec "$manager" "$cmd" "$@" ;;
  on|off)
    [ -f "$config" ] || { echo "workstation-apps: run chezmoi init first" >&2; exit 2; }
    [ "$#" -gt 0 ] || { echo "workstation-apps: specify at least one app" >&2; exit 2; }
    for item in "$@" ${selected[@]+"${selected[@]}"}; do
      "$manager" list | grep -qxF "$item" || { echo "workstation-apps: unknown app: $item" >&2; exit 2; }
    done
    value=""; requested="$(printf '%s\n' "$@")"
    while IFS= read -r item; do
      keep=false
      printf '%s\n' ${selected[@]+"${selected[@]}"} | grep -qxF "$item" && keep=true
      if grep -qxF "$item" <<<"$requested"; then
        [ "$cmd" = off ] && keep=false || keep=true
      fi
      if $keep; then value="$value${value:+, }\"$item\""; fi
    done < <("$manager" list)
    "$repo/lib/toml-set.sh" "$config" data workstationApps "[$value]"
    echo "workstation-apps: selected [$value]; no apps installed or removed"
    echo "Next: workstation-apps plan, then workstation-apps install"
    ;;
  -h|--help) sed -n '2,4s/^# //p' "$0" ;;
  *) echo "workstation-apps: unknown command: $cmd" >&2; exit 2 ;;
esac
