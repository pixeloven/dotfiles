#!/usr/bin/env bash
# lastreply: render the newest Claude Code (or Codex) reply with glow, for a herdr split
# beside the chat. Reads the session transcripts; --watch also keeps a read marker per session.
# Usage: lastreply [--open] [--watch] [--codex] [--raw] [--session ID]
#   --codex       read ~/.codex/sessions instead of ~/.claude/projects
#   --watch       read the session's finished replies one at a time; a new one only raises
#                 the unread count, the view moves on a key: Space/n/→ next (marks read),
#                 p/← previous, u oldest unread, G/End latest (marks all read),
#                 Enter page the card in less, q quit
#   --raw         print the markdown without glow
#   --session ID  follow that session ($CLAUDE_CODE_SESSION_ID or Codex's $CODEX_THREAD_ID)
#   --open        split the current herdr pane and run --watch there for this session;
#                 inside Codex it follows Codex automatically
# Which session: --session, else the agent herdr reports in this pane's tab, else the newest
# session for the current folder, else the newest anywhere.
# A reply is all the text the assistant wrote since your last prompt, across tool calls
# (for Codex, only its final answer, not its progress notes).
# Read state: ${XDG_STATE_HOME:-~/.local/state}/lastreply/<transcript name>, pruned after 30 days.

set -uo pipefail

agent=claude watch="" raw="" session="" open=""
while [ $# -gt 0 ]; do
  case "$1" in
    --codex) agent=codex ;;
    --watch) watch=1 ;;
    --raw) raw=1 ;;
    --open) open=1 ;;
    --session) session="${2:-}"; shift ;;
    -h|--help) sed -n '2,19s/^# \{0,1\}//p' "$0"; exit 0 ;;
    *) echo "lastreply: unknown option $1 (try --help)" >&2; exit 2 ;;
  esac
  shift
done

case "$session" in
  *[!A-Za-z0-9._-]*) echo "lastreply: --session takes a session id (letters, digits, . _ -)" >&2; exit 2 ;;
esac

if [ -n "$open" ]; then
  if [ -z "${HERDR_PANE_ID:-}" ]; then
    echo "lastreply: --open needs to run inside a herdr pane" >&2
    exit 1
  fi
  # Run from inside Codex, follow Codex even without --codex.
  [ -z "${CLAUDE_CODE_SESSION_ID:-}" ] && [ -n "${CODEX_THREAD_ID:-}" ] && agent=codex
  if [ "$agent" = codex ]; then
    session="${session:-${CODEX_THREAD_ID:-}}"
  else
    session="${session:-${CLAUDE_CODE_SESSION_ID:-}}"
  fi
  case "$session" in *[!A-Za-z0-9._-]*) session="" ;; esac
  cmd="lastreply --watch"
  [ "$agent" = codex ] && cmd="$cmd --codex"
  [ -n "$session" ] && cmd="$cmd --session $(printf '%q' "$session")"
  pane="$(herdr pane split --current --direction right --cwd "$PWD" | jq -r '.result.pane.pane_id // empty')"
  if [ -z "$pane" ]; then
    echo "lastreply: herdr did not open a pane" >&2
    exit 1
  fi
  herdr pane run "$pane" "$cmd" >/dev/null
  echo "lastreply: watching in herdr pane $pane"
  exit 0
fi

newest() { # newest *.jsonl directly inside the given folders
  find "$@" -maxdepth 1 -name '*.jsonl' -type f -exec ls -t {} + 2>/dev/null | head -1
}

tab_session() { # session id of this agent type running in the same herdr tab, if any
  [ -n "${HERDR_TAB_ID:-}" ] || return 0
  herdr agent list 2>/dev/null | jq -r --arg tab "$HERDR_TAB_ID" --arg agent "$agent" \
    '[.result.agents[]? | select(.tab_id == $tab and .agent == $agent) | .agent_session.value // empty] | first // empty' 2>/dev/null
}

by_id() { # transcript file for a session id, if one exists
  if [ "$agent" = codex ]; then
    find "$HOME/.codex/sessions" -name "*$1*.jsonl" -type f 2>/dev/null | head -1
  else
    find "$HOME/.claude/projects" -mindepth 2 -maxdepth 2 -name "$1.jsonl" -type f 2>/dev/null | head -1
  fi
}

codex_for_folder() { # newest of the recent Codex rollouts whose session started in this folder
  local f
  find "$HOME/.codex/sessions" -name '*.jsonl' -type f -exec ls -t {} + 2>/dev/null | head -50 |
    while IFS= read -r f; do
      if head -1 "$f" | jq -e --arg cwd "$PWD" '.payload.cwd == $cwd' >/dev/null 2>&1; then
        printf '%s' "$f"
        break
      fi
    done
}

transcript() {
  local id here file=""
  if [ -n "$session" ]; then
    by_id "$session"
    return
  fi
  id="$(tab_session)"
  [ -n "$id" ] && file="$(by_id "$id")"
  if [ -z "$file" ] && [ "$agent" = codex ]; then
    file="$(codex_for_folder)"
    [ -n "$file" ] || file="$(find "$HOME/.codex/sessions" -name '*.jsonl' -type f -exec ls -t {} + 2>/dev/null | head -1)"
  elif [ -z "$file" ]; then
    here="$HOME/.claude/projects/$(pwd | sed 's/[^A-Za-z0-9]/-/g')"
    [ -d "$here" ] && file="$(newest "$here")"
    [ -n "$file" ] || file="$(newest "$HOME"/.claude/projects/*/)"
  fi
  printf '%s' "$file"
}

# Split the transcript into turns at each real prompt. A turn is finished once the agent ended
# it (Claude stop_reason end_turn/stop_sequence, Codex task_complete) or a later prompt began.
# The pane shows a turn as a review card: your prompt (shortened) and the time, then the reply.
# shellcheck disable=SC2016  # jq programs, not shell expansions
COMMON_JQ='
  def prompt_text:
    if (test("<command-name>")) then
      ((capture("<command-name>(?<n>[^<]*)</command-name>").n) + " "
        + ((capture("<command-args>(?<a>[^<]*)</command-args>").a) // "")) | sub(" +$"; "")
    else
      gsub("<(?<t>[a-z_-]+)( [^>]*)?>[\\s\\S]*?</(?<u>[a-z_-]+)>"; "")
      | gsub("<[^>]+>"; "") | gsub("\\s+"; " ") | sub("^ "; "") | sub(" $"; "")
      | if length > 240 then .[0:240] + "…" else . end
    end;
  def opener: # a wake from a background task or hook shows its summary, not "(no text)"
    if test("<task-notification>") then
      {kind: "wake", prompt: ("⚑ " + ([capture("<summary>(?<s>[^<]*)</summary>").s][0] // "notification"))}
    else {kind: "you", prompt: prompt_text} end;
  def turn($time): . + {time: $time, texts: [], done: false};
  def clock: if . then (sub("\\.[0-9]+"; "") | fromdateiso8601 | localtime | strftime("%I:%M %p") | sub("^0"; "")) else "" end;
  def turns: # the turns with reply text; a later prompt also finishes a turn
    (length - 1) as $end
    | [to_entries[] | .value + {done: (.value.done or .key < $end)} | select(.texts | length > 0)];
  def card:
    (if .kind == "wake" then "**Wake**" elif .kind == "compact" then "**Session**" else "**You**" end)
    + " · " + (.time | clock) + "\n\n"
    + (if .prompt == "" then "> (no text)" else "> " + .prompt end)
    + "\n\n---\n\n" + (.texts | join("\n\n"));
  def last_card: turns | last | if . == null then "" else card end;
  def queue: turns | {turns: map(select(.done)), writing: ((last // {done: true}) | .done | not)};'
# shellcheck disable=SC2016
CLAUDE_JQ="$COMMON_JQ"'
  [ .[] | select(.isSidechain != true and .isMeta != true and (.type == "user" or .type == "assistant")) ]
  | reduce .[] as $e ([{kind: "you", prompt: ""} | turn(null)];
      ($e.message.content) as $c
      | if $e.type == "user" then
          if $e.isCompactSummary == true then
            . + [{kind: "compact", prompt: "(context compacted)"} | turn($e.timestamp)]
          elif ($c | type) == "string" then
            . + [$c | opener | turn($e.timestamp)]
          elif ([$c[]?.type] | index("tool_result") | not) then
            . + [[$c[]? | select(.type == "text") | .text] | join(" ") | opener | turn($e.timestamp)]
          else . end
        else
          .[-1].texts += [ if ($c | type) == "array" then $c[] | select(.type == "text") | .text else $c end ]
          | .[-1].done = (($e.message.stop_reason // "") | . == "end_turn" or . == "stop_sequence")
        end)'
# shellcheck disable=SC2016
CODEX_JQ="$COMMON_JQ"'
  [ .[] | if .type == "response_item" and .payload.type == "message" then .payload + {time: .timestamp}
          elif .type == "event_msg" and .payload.type == "task_complete" then {role: "done"}
          else empty end ]
  | reduce .[] as $m ([{kind: "you", prompt: ""} | turn(null)];
      if $m.role == "user" then
        ([$m.content[]? | .text // empty] | join(" ") | opener) as $p
        | if $p.prompt == "" then . else . + [$p | turn($m.time)] end
      elif $m.role == "assistant" and (($m.phase // "final_answer") == "final_answer") then
        .[-1].texts += [ $m.content[]? | select(.type == "output_text") | .text ]
      elif $m.role == "done" then .[-1].done = true
      else . end)'

parse() { # <file> <jq filter> : the transcript's turns through that filter; skips a half-written
  local prog="$CLAUDE_JQ"  # last line instead of failing
  [ "$agent" = codex ] && prog="$CODEX_JQ"
  jq -R 'fromjson? // empty' "$1" | jq -rs "$prog | $2"
}

style="$HOME/.config/glow/catppuccin-mocha.json"
[ -f "$style" ] || style=dark

file="$(transcript)"
if [ -z "$file" ]; then
  echo "lastreply: no $( [ "$agent" = codex ] && echo Codex || echo Claude ) transcript found" >&2
  exit 1
fi

if [ -z "$watch" ]; then
  text="$(parse "$file" last_card)"
  if [ -n "$raw" ]; then
    printf '%s\n' "$text"
  else
    printf '%s\n' "$text" | glow -s "$style" -
  fi
  exit 0
fi

# The reader. The transcript is the queue: each read caches its finished turns as JSON, and
# keys index into that cache. The read marker is the start time of the newest reply read.
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/lastreply"
find "$state_dir" -type f -mtime +30 -delete 2>/dev/null
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
trap 'exit 0' INT TERM HUP
trap 'dirty=1' WINCH
cache="$tmp/turns.json"

load_state() { # the read marker for $file; a first open starts at the latest finished reply
  state="$state_dir/$(basename "$file" .jsonl)"
  marker="" fresh=1 placed="" cur=-1 read_i=-1 n=0 times=()
  if [ -f "$state" ]; then
    marker="$(sed -n 's/^read_through=//p' "$state" | head -1)"
    fresh=""
  fi
}

save_state() { # written atomically, so a crash never leaves half a file
  mkdir -p "$state_dir" && printf 'read_through=%s\n' "$marker" > "$state.$$" && mv -f "$state.$$" "$state"
}

mark_read() { # <index> : everything up to that reply is read
  [ "$1" -gt "$read_i" ] || return 0
  read_i=$1
  marker="${times[$1]}"
  save_state
}

load_queue() { # re-read the transcript; keeps the old cache if this read came back empty
  local t i
  parse "$file" queue > "$tmp/new" 2>/dev/null && [ -s "$tmp/new" ] || return 1
  mv -f "$tmp/new" "$cache"
  writing="$(jq -r '.writing' "$cache")"
  times=()
  while IFS= read -r t; do times+=("$t"); done < <(jq -r '.turns[] | .time // "-"' "$cache")
  n=${#times[@]}
  if [ -n "$fresh" ]; then
    fresh=""
    [ "$n" -gt 0 ] && marker="${times[n - 1]}"
    save_state
  fi
  read_i=-1
  if [ -n "$marker" ]; then
    i=0
    while [ "$i" -lt "$n" ]; do
      t="${times[i]}"
      [[ "$t" < "$marker" || "$t" == "$marker" ]] && read_i=$i
      i=$((i + 1))
    done
  fi
  # The first read opens at the oldest unread reply (the latest, on a first open);
  # after that only a key moves the view.
  [ -n "$placed" ] || placed=1 cur=$((read_i + 1))
  [ "$cur" -lt "$n" ] || cur=$((n - 1))
  return 0
}

draw() { # the card from its top, cut to the pane, then a status bar on the last line
  local rows=40 cols=100 body total pad unread line hint size
  # stty reads the pane size from stdin; tput with stderr redirected falls back to 24x80.
  if [ -t 0 ] && size="$(stty size 2>/dev/null)" && [ -n "$size" ]; then
    rows="${size% *}" cols="${size#* }"
  fi
  body=$((rows - 1))
  if [ "$cur" -lt 0 ]; then
    if [ "$n" -gt 0 ]; then echo "Press Space for the next reply."; else echo "No finished reply yet."; fi > "$tmp/card"
  elif [ -n "$raw" ]; then
    jq -r --argjson i "$cur" "$COMMON_JQ"' .turns[$i] | card' "$cache" > "$tmp/card"
  else
    # Pipe the output so glow can never open its pager (the config turns it on), which
    # would stall the reader. An explicit style keeps the colours.
    jq -r --argjson i "$cur" "$COMMON_JQ"' .turns[$i] | card' "$cache" |
      glow -s "$style" -w "$cols" - | cat > "$tmp/card"
  fi
  total=$(($(wc -l < "$tmp/card")))
  clear
  head -n "$body" "$tmp/card"
  pad=$total
  while [ "$pad" -lt "$body" ]; do echo; pad=$((pad + 1)); done
  unread=$((n - 1 - read_i))
  line=" $((cur + 1))/$n"
  if [ "$unread" -gt 0 ]; then line="$line  ● $unread unread"; else line="$line  ✓ caught up"; fi
  [ "$total" -gt "$body" ] && line="$line · ▼ $((total - body)) more lines, Enter"
  [ "$writing" = true ] && line="$line · ✎ writing"
  hint="   [space] next  [p] prev  [u] unread  [G] latest  [enter] page  [q] quit"
  [ $((${#line} + ${#hint})) -le "$cols" ] && line="$line$hint"
  if [ -t 1 ]; then printf '\033[7m%s\033[0m' "$line"; else printf '%s\n' "$line"; fi
}

# Size and sub-second mtime, so two writes within one second still count as a change.
# GNU stat's -f means file-system status, so pick the format by which stat this is.
if stat -c %s / >/dev/null 2>&1; then
  stat_fmt=(-c '%.9Y %s')
else
  stat_fmt=(-f '%Fm %z')
fi

# Poll the transcript every 2 s while waiting for a key. Once stdin has no more keys to give
# (closed, or not a terminal), keep polling with sleep so new replies still count.
opened="" last="" shown="" keys="" dirty=1 writing=false
{ [ -t 0 ] || [ -p /dev/stdin ]; } && keys=1
while :; do
  file="$(transcript)"
  if [ "$file" != "$opened" ]; then
    opened="$file" last=""
    load_state
  fi
  stamp="$file $(stat "${stat_fmt[@]}" "$file" 2>/dev/null)"
  if [ "$stamp" != "$last" ]; then
    last="$stamp"
    load_queue && [ "$n $read_i $writing" != "$shown" ] && dirty=1
  fi
  if [ -n "$dirty" ]; then
    draw
    dirty="" shown="$n $read_i $writing"
  fi
  if [ -z "$keys" ]; then
    sleep 2
    continue
  fi
  key="" action="" waited=$SECONDS
  if ! IFS= read -rsn1 -t 2 key; then
    # bash 3.2 returns 1 for a timeout and for end of input alike; only a timeout took 2 s.
    [ $((SECONDS - waited)) -ge 2 ] || keys=""
    continue
  fi
  case "$key" in
    " "|n) action=next ;;
    p) action=prev ;;
    u) action=unread ;;
    G) action=latest ;;
    "") action=page ;;
    q) exit 0 ;;
    $'\e') # arrow and End keys: ESC [ C, ESC O C, ESC [ F, ESC [ 4 ~ ...
      seq=""
      IFS= read -rsn2 -t 1 seq
      case "$seq" in "[1"|"[4"|"[8") IFS= read -rsn1 -t 1 _ ;; esac
      case "$seq" in
        "[C"|OC) action=next ;;
        "[D"|OD) action=prev ;;
        "[F"|OF|"[4"|"[8") action=latest ;;
      esac ;;
  esac
  case "$action" in
    next)
      [ "$cur" -ge 0 ] && mark_read "$cur"
      [ "$cur" -lt $((n - 1)) ] && cur=$((cur + 1)) ;;
    prev) [ "$cur" -gt 0 ] && cur=$((cur - 1)) ;;
    unread) [ "$read_i" -lt $((n - 1)) ] && cur=$((read_i + 1)) ;;
    latest)
      if [ "$n" -gt 0 ]; then
        cur=$((n - 1))
        mark_read "$cur"
      fi ;;
    page) [ "$cur" -ge 0 ] && less -R "$tmp/card" ;;
  esac
  [ -n "$action" ] && dirty=1
done
