#!/usr/bin/env bash
# lastreply: render the newest Claude Code (or Codex) reply with glow, for a herdr split
# beside the chat. Reads the session transcripts only; never writes anything.
# Usage: lastreply [--codex] [--watch] [--raw] [--session ID]
#   --codex       read ~/.codex/sessions instead of ~/.claude/projects
#   --watch       re-render whenever the transcript changes (Ctrl+C to stop)
#   --raw         print the markdown without glow
#   --session ID  follow that session (Claude Code: $CLAUDE_CODE_SESSION_ID)
#   --open        split the current herdr pane and run --watch there for this session
# Which session: --session, else the agent herdr reports in this pane's tab, else the newest
# session for the current folder, else the newest anywhere.
# A reply is all the text the assistant wrote since your last prompt, across tool calls.

set -uo pipefail

agent=claude watch="" raw="" session="" open=""
while [ $# -gt 0 ]; do
  case "$1" in
    --codex) agent=codex ;;
    --watch) watch=1 ;;
    --raw) raw=1 ;;
    --open) open=1 ;;
    --session) session="${2:-}"; shift ;;
    -h|--help) sed -n '2,13s/^# \{0,1\}//p' "$0"; exit 0 ;;
    *) echo "lastreply: unknown option $1 (try --help)" >&2; exit 2 ;;
  esac
  shift
done

if [ -n "$open" ]; then
  if [ -z "${HERDR_PANE_ID:-}" ]; then
    echo "lastreply: --open needs to run inside a herdr pane" >&2
    exit 1
  fi
  [ "$agent" = claude ] && session="${session:-${CLAUDE_CODE_SESSION_ID:-}}"
  cmd="lastreply --watch"
  [ "$agent" = codex ] && cmd="$cmd --codex"
  [ -n "$session" ] && cmd="$cmd --session $session"
  pane="$(herdr pane split --current --direction right --cwd "$PWD" | jq -r '.result.pane.pane_id // empty')"
  if [ -z "$pane" ]; then
    echo "lastreply: herdr did not open a pane" >&2
    exit 1
  fi
  herdr pane run "$pane" "$cmd" >/dev/null
  echo "lastreply: watching in herdr pane $pane"
  exit 0
fi

newest() { # newest *.jsonl directly inside the given folders
  find "$@" -maxdepth 1 -name '*.jsonl' -type f -print0 2>/dev/null | xargs -0 ls -t 2>/dev/null | head -1
}

tab_session() { # session id of this agent type running in the same herdr tab, if any
  [ -n "${HERDR_TAB_ID:-}" ] || return 0
  herdr agent list 2>/dev/null | jq -r --arg tab "$HERDR_TAB_ID" --arg agent "$agent" \
    '[.result.agents[]? | select(.tab_id == $tab and .agent == $agent) | .agent_session.value // empty] | first // empty' 2>/dev/null
}

by_id() { # transcript file for a session id, if one exists
  if [ "$agent" = codex ]; then
    find "$HOME/.codex/sessions" -name "*$1*.jsonl" -type f 2>/dev/null | head -1
  else
    find "$HOME/.claude/projects" -mindepth 2 -maxdepth 2 -name "$1.jsonl" -type f 2>/dev/null | head -1
  fi
}

transcript() {
  local id here file=""
  if [ -n "$session" ]; then
    by_id "$session"
    return
  fi
  id="$(tab_session)"
  [ -n "$id" ] && file="$(by_id "$id")"
  if [ -z "$file" ] && [ "$agent" = codex ]; then
    file="$(find "$HOME/.codex/sessions" -name '*.jsonl' -type f -print0 2>/dev/null | xargs -0 ls -t 2>/dev/null | head -1)"
  elif [ -z "$file" ]; then
    here="$HOME/.claude/projects/$(pwd | sed 's/[^A-Za-z0-9]/-/g')"
    [ -d "$here" ] && file="$(newest "$here")"
    [ -n "$file" ] || file="$(newest "$HOME"/.claude/projects/*/)"
  fi
  printf '%s' "$file"
}

# Split the transcript into turns at each real prompt and keep the last one with reply text.
# The pane shows it as a review card: your prompt (shortened) and the time, then the reply.
# shellcheck disable=SC2016  # jq programs, not shell expansions
COMMON_JQ='
  def prompt_text:
    if (test("<command-name>")) then
      ((capture("<command-name>(?<n>[^<]*)</command-name>").n) + " "
        + ((capture("<command-args>(?<a>[^<]*)</command-args>").a) // "")) | sub(" +$"; "")
    else
      gsub("<(?<t>[a-z_-]+)( [^>]*)?>[\\s\\S]*?</(?<u>[a-z_-]+)>"; "")
      | gsub("<[^>]+>"; "") | gsub("\\s+"; " ") | sub("^ "; "") | sub(" $"; "")
      | if length > 240 then .[0:240] + "…" else . end
    end;
  def clock: if . then (sub("\\.[0-9]+"; "") | fromdateiso8601 | localtime | strftime("%I:%M %p") | sub("^0"; "")) else "" end;
  def card:
    map(select(.texts | length > 0)) | last
    | if . == null then "" else
        "**You** · " + (.time | clock) + "\n\n"
        + (if .prompt == "" then "> (no text)" else "> " + .prompt end)
        + "\n\n---\n\n" + (.texts | join("\n\n"))
      end;'
# shellcheck disable=SC2016
CLAUDE_JQ="$COMMON_JQ"'
  [ .[] | select(.isSidechain != true and .isMeta != true and (.type == "user" or .type == "assistant")) ]
  | reduce .[] as $e ([{prompt: "", time: null, texts: []}];
      ($e.message.content) as $c
      | if $e.type == "user" then
          if ($c | type) == "string" then
            . + [{prompt: ($c | prompt_text), time: $e.timestamp, texts: []}]
          elif ([$c[]?.type] | index("tool_result") | not) then
            . + [{prompt: ([$c[]? | select(.type == "text") | .text] | join(" ") | prompt_text), time: $e.timestamp, texts: []}]
          else . end
        else
          .[-1].texts += [ if ($c | type) == "array" then $c[] | select(.type == "text") | .text else $c end ]
        end)
  | card'
# shellcheck disable=SC2016
CODEX_JQ="$COMMON_JQ"'
  [ .[] | select(.type == "response_item" and .payload.type == "message") | .payload + {time: .timestamp} ]
  | reduce .[] as $m ([{prompt: "", time: null, texts: []}];
      if $m.role == "user" then
        ([$m.content[]? | .text // empty] | join(" ") | prompt_text) as $p
        | if $p == "" then . else . + [{prompt: $p, time: $m.time, texts: []}] end
      elif $m.role == "assistant" then .[-1].texts += [ $m.content[]? | select(.type == "output_text") | .text ]
      else . end)
  | card'

render() {
  local file="$1" text style="$HOME/.config/glow/catppuccin-mocha.json"
  [ -f "$style" ] || style=dark
  if [ "$agent" = codex ]; then
    text="$(jq -rs "$CODEX_JQ" "$file")"
  else
    text="$(jq -rs "$CLAUDE_JQ" "$file")"
  fi
  if [ -n "$raw" ]; then
    printf '%s\n' "$text"
  elif [ -n "$watch" ]; then
    # Pipe the output so glow can never open its pager (the config turns it on), which
    # would stall the loop on the first reply. An explicit style keeps the colours.
    printf '%s\n' "$text" | glow -s "$style" -w "$(tput cols 2>/dev/null || echo 100)" - | cat
  else
    printf '%s\n' "$text" | glow -s "$style" -
  fi
}

file="$(transcript)"
if [ -z "$file" ]; then
  echo "lastreply: no $( [ "$agent" = codex ] && echo Codex || echo Claude ) transcript found" >&2
  exit 1
fi

if [ -z "$watch" ]; then
  render "$file"
  exit 0
fi

last=""
while :; do
  file="$(transcript)"
  stamp="$file $(stat -f %m "$file" 2>/dev/null)"
  if [ "$stamp" != "$last" ]; then
    last="$stamp"
    clear
    render "$file"
  fi
  sleep 2
done
