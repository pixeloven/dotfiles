{{- $terminal := "ghostty" -}}
{{- $installTarget := "host" -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   $terminal = promptChoiceOnce . "terminal" "Terminal app on this Linux machine" (list "ptyxis" "ghostty" "other") "ptyxis" -}}
{{-   $suggested := "host" -}}
{{-   if or (stat "/run/ostree-booted") (stat "/run/host/run/ostree-booted") -}}{{ $suggested = "distrobox" }}{{- end -}}
{{-   $installTarget = promptChoiceOnce . "installTarget" "Install tools on this host, or only inside a distrobox" (list "host" "distrobox") $suggested -}}
{{- end -}}
{{- $sets := list -}}
{{- range include "../lib/toolsets.txt" | splitList "\n" -}}
{{-   if and (trim .) (not (hasPrefix "#" .)) }}{{ $sets = append $sets (regexFind "^\\S+" .) }}{{ end -}}
{{- end -}}
{{- $toolsets := list -}}
{{- if and (not (hasKey . "toolsets")) (hasKey . "opsTools") -}}
{{-   if eq (toString .opsTools) "true" }}{{ $toolsets = $sets }}{{ end -}}
{{- else -}}
{{-   $toolsets = promptMultichoiceOnce . "toolsets" "Ops tool sets to install (lib/toolsets.txt; none by default)" $sets (get . "toolsets" | default list) -}}
{{- end -}}
{{- $container := or (env "CONTAINER_ID") (stat "/run/.containerenv") (stat "/.dockerenv") | not | not -}}
# Linux asks the terminal and where tools install; both OSes ask which ops tool sets to install
# (a machine from before that question keeps its old opsTools answer: yes is every set, no is none).
# Each is asked once. Keys set by hand are kept. This repo holds no names, emails, or other personal data.
sourceDir = "~/Development/dotfiles"

[data]
terminal = {{ $terminal | quote }}
installTarget = {{ $installTarget | quote }}
toolsets = {{ $toolsets | toToml }}
container = {{ $container }}
{{- range list "agentPlugins" "operatorPersona" "operatorHome" }}
{{-   if hasKey $ . }}
{{ . }} = {{ get $ . | toJson }}
{{-   end }}
{{- end }}
