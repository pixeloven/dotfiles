# Ghostty config — managed by chezmoi (~/Development/dotfiles). See CUSTOMIZE.md.
# All options: ghostty +show-config --default --docs

# Theme: dark only
theme = Catppuccin Mocha

# Font: the Nerd Font build adds the icons eza and the prompt use (ligatures off; remove the two
# font-feature lines to turn them on)
font-family = JetBrainsMono Nerd Font
font-size = 14
font-feature = -calt
font-feature = -liga

# Window
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
background-opacity = 0.96

# Behaviour
copy-on-select = clipboard
shell-integration-features = cursor,sudo,title

# Notify when a long command finishes in an unfocused window
notify-on-command-finish = unfocused
notify-on-command-finish-after = 30s
notify-on-command-finish-action = bell,notify
bell-features = system,attention,title

# Per-OS settings; the other OS's file is never installed (see home/.chezmoiignore)
config-file = ?macos.ghostty
config-file = ?linux.ghostty

# Optional tactical look — see RUNBOOK.md "Optional tactical shader"
# custom-shader = shaders/crt.glsl
