# 1Password service account for this shell — managed by chezmoi. Sourced by dotfiles.zsh. Holds no
# secret: the token lives only in ~/.config/harmony/op-sa-token (mode 0600, placed by hand, never
# committed; RUNBOOK section 11). Without that file, or with it empty, this does nothing. With it,
# it exports OP_SERVICE_ACCOUNT_TOKEN, then each variable in the chezmoi data table opEnv (name →
# op:// ref, set by hand in ~/.config/chezmoi/chezmoi.toml) from `op read`, skipping one already
# set. An `op read` that fails or takes longer than the timeout leaves that variable unset. xtrace
# is off inside, so `set -x` never prints a value. DOTFILES_OP_TOKEN_FILE is a test seam.
{{- $refs := get . "opEnv" | default dict }}
{{- range $name, $ref := $refs }}
{{-   if not (regexMatch "^[A-Za-z_][A-Za-z0-9_]*$" $name) }}{{ fail (printf "opEnv: %q is not a shell variable name" $name) }}{{ end }}
{{-   if not (regexMatch "^op://[^'\n]+$" (toString $ref)) }}{{ fail (printf "opEnv.%s: %q is not an op:// reference" $name $ref) }}{{ end }}
{{- end }}
_dotfiles_op_env() {
  setopt local_options no_xtrace
  local file=${DOTFILES_OP_TOKEN_FILE:-$HOME/.config/harmony/op-sa-token} mode name value
  [[ -f $file && -r $file && -s $file ]] || return 0
  mode=$(stat -c %a -- "$file" 2>/dev/null || stat -f %Lp -- "$file" 2>/dev/null)
  [[ $mode == 600 ]] || print -ru2 -- "dotfiles: $file is mode ${mode:-unknown}, not 600; run: chmod 600 $file"
  export OP_SERVICE_ACCOUNT_TOKEN="$(<$file)"
  local -A refs=(
{{- range $name, $ref := $refs }}
    {{ $name }} {{ toString $ref | squote }}
{{- end }}
  )
  (( ${#refs} )) && (( $+commands[op] )) || return 0
  for name in ${(k)refs}; do
    [[ -n ${(P)name:-} ]] && continue
    value=$(_dotfiles_op_read $refs[$name]) && [[ -n $value ]] && export "$name=$value"
  done
}

# op read <ref>, killed after DOTFILES_OP_READ_TIMEOUT seconds (default 3) so a slow or offline
# 1Password never holds up the prompt. Portable: macOS has no timeout(1).
_dotfiles_op_read() {
  op read --no-newline -- "$1" </dev/null 2>/dev/null &
  local pid=$!
  ( trap 'kill $s' TERM; sleep ${DOTFILES_OP_READ_TIMEOUT:-3} & s=$!; wait $s && kill $pid ) >/dev/null 2>&1 &
  local timer=$!
  wait $pid
  local rc=$?
  kill $timer 2>/dev/null
  return $rc
}

_dotfiles_op_env
unfunction _dotfiles_op_env _dotfiles_op_read
