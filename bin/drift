#!/usr/bin/env bash
# Report local changes that are not yet codified in this repo. Read-only; always exits 0.
#
# Usage: drift [--summary | --hook | --json]
#   (default)  one finding per line: <kind>\t<target>\t<suggested action>
#   --summary  one line "dotfiles: N changes not codified - run /codify", or nothing
#   --hook     the summary as Claude Code hook JSON ({"systemMessage": ...}), shown to the user
#   --json     findings as a JSON array of {kind, target, action}
#
# Kinds: edited, owned-key, pkg-extra, pkg-missing, plugin-missing, plugin-behind, untracked-config.
# plugin-behind: an installed plugin differs from this machine's local catalogue copy. The check is offline,
# so a newly published marketplace re-pin is found by the operator's crew check and lib/agent-plugins.sh update.
# Paths in lib/denylist.txt and packages in lib/drift-ignore.txt are never reported.
# DRIFT_CHEZMOI_ARGS adds chezmoi flags (tests use it to point at a scratch source/state).
set -uo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck disable=SC2206
CZ=(chezmoi ${DRIFT_CHEZMOI_ARGS:-})
WATCHED_DIRS=(.config/ghostty .config/herdr .config/bat .config/glow .config/zsh Library/Preferences/glow .claude/themes)

denylisted() { # a glob without / matches the file name, one with / the end of the path
  local name glob
  name="$(basename "$1")"
  while IFS= read -r glob; do
    case "$glob" in ''|'#'*) continue ;; esac
    # shellcheck disable=SC2254
    case "$glob" in
      */*) case "$1" in $glob|*/$glob) return 0 ;; esac ;;
      *) case "$name" in $glob) return 0 ;; esac ;;
    esac
  done < "$REPO/lib/denylist.txt"
  return 1
}

# .chezmoiignore is a template with per-OS blocks, so chezmoi renders it for this machine.
# (`chezmoi ignored` lists only ignored source files, not patterns such as herdr's runtime files.)
IGNORED="$("${CZ[@]}" execute-template < "$REPO/home/.chezmoiignore" 2>/dev/null)"

chezmoi_ignored() {
  local pat
  while IFS= read -r pat; do
    case "$pat" in ''|'#'*) continue ;; esac
    # shellcheck disable=SC2254
    case "$1" in $pat|$pat/*) return 0 ;; esac
  done <<<"$IGNORED"
  return 1
}

drift_ignored() {
  [ -f "$REPO/lib/drift-ignore.txt" ] && grep -qxF "$1" "$REPO/lib/drift-ignore.txt"
}

emit() { printf '%s\t%s\t%s\n' "$1" "$2" "$3"; }

edited() {
  local line path
  "${CZ[@]}" status --exclude scripts 2>/dev/null | while IFS= read -r line; do
    [ "${line:0:1}" = " " ] && continue
    path="${line:3}"
    denylisted "$path" && continue
    emit edited "$path" "chezmoi re-add ~/$path"
  done
}

owned_hooks() { # <settings> <fragment> <label> : report fragment events missing from settings
  local settings="$1" fragment="$2" label="$3"
  [ -f "$settings" ] && jq -e . "$settings" > /dev/null 2>&1 || return 0
  jq -r --slurpfile f "$fragment" '
    . as $s
    | $f[0].hooks | to_entries[]
    | .key as $ev
    | select(any(.value[].hooks[].command; . as $c | ($s.hooks[$ev] // []) | all(.hooks[]?.command != $c)))
    | $ev' "$settings" | while IFS= read -r ev; do
    emit owned-key "$label hooks.$ev" "edit lib/$(basename "$fragment") then chezmoi apply"
  done
}

owned_keys() {
  # shellcheck disable=SC2088  # literal ~ labels for humans
  owned_hooks "$HOME/.claude/settings.json" "$REPO/lib/claude-hooks.fragment.json" "~/.claude/settings.json"
  if [ -f "$REPO/lib/codex-hooks.fragment.json" ] && command -v codex >/dev/null 2>&1; then
    # shellcheck disable=SC2088
    owned_hooks "$HOME/.codex/hooks.json" "$REPO/lib/codex-hooks.fragment.json" "~/.codex/hooks.json"
  fi

  local line key want have parts
  grep -E '^git config --global ' "$REPO/home/.chezmoiscripts/run_onchange_after_20-gitconfig.sh" |
    while IFS= read -r line; do
      eval "parts=(${line#git config --global })"
      key="${parts[0]}" want="${parts[1]}"
      have="$(git config --global --get "$key" 2>/dev/null || true)"
      [ "$have" = "$want" ] && continue
      # shellcheck disable=SC2088  # literal ~ label for humans
      emit owned-key "~/.gitconfig $key" "edit home/.chezmoiscripts/run_onchange_after_20-gitconfig.sh then chezmoi apply"
    done
}

ptyxis_keys() { # the Ptyxis settings the ptyxis script owns, only where it renders (terminal = ptyxis)
  local script line schema key want have uuid parts PROFILE
  script="$("${CZ[@]}" execute-template < "$REPO/home/.chezmoiscripts/run_onchange_after_50-ptyxis.sh.tmpl" 2>/dev/null)"
  grep -q '^own ' <<<"$script" || return 0
  eval "$(grep '^gs() ' <<<"$script")" # gsettings here, or on the host from a distrobox
  gs list-keys org.gnome.Ptyxis > /dev/null 2>&1 || return 0
  uuid="$(gs get org.gnome.Ptyxis default-profile-uuid 2>/dev/null | tr -d "'")"
  # shellcheck disable=SC2034  # read by the eval of the own lines
  PROFILE="org.gnome.Ptyxis.Profile:/org/gnome/Ptyxis/Profiles/$uuid/"
  grep '^own ' <<<"$script" | while IFS= read -r line; do
    eval "parts=(${line#own })"
    schema="${parts[0]}" key="${parts[1]}" want="${parts[2]}"
    [ -z "$uuid" ] && [[ "$schema" == *.Profile:* ]] && continue
    have="$(gs get "$schema" "$key" 2>/dev/null || true)"
    [ "$have" = "$want" ] && continue
    emit owned-key "${schema%%:*} $key" "edit home/.chezmoiscripts/run_onchange_after_50-ptyxis.sh.tmpl then chezmoi apply"
  done
}

zshrc_line() { # the one line we own in the otherwise private ~/.zshrc
  local script="$REPO/home/.chezmoiscripts/run_onchange_after_40-zshrc-source.sh" line
  [ -f "$script" ] || return 0
  line="$(sed -n "s/^LINE='\(.*\)'$/\1/p" "$script")"
  [ -n "$line" ] && [ -f "$HOME/.zshrc" ] && grep -qxF "$line" "$HOME/.zshrc" && return 0
  # shellcheck disable=SC2088  # literal ~ label for humans
  emit owned-key "~/.zshrc dotfiles source line" "sh home/.chezmoiscripts/run_onchange_after_40-zshrc-source.sh"
}

codex_keys() {
  local table key want have
  [ -f "$REPO/lib/codex-owned-keys.txt" ] && command -v codex >/dev/null 2>&1 || return 0
  grep -v '^#' "$REPO/lib/codex-owned-keys.txt" | while read -r table key want; do
    [ -n "$table" ] || continue
    have="$("$REPO/lib/toml-set.sh" --get "$HOME/.codex/config.toml" "$table" "$key" 2>/dev/null || true)"
    [ "$have" = "$want" ] && continue
    # shellcheck disable=SC2088  # literal ~ label for humans
    emit owned-key "~/.codex/config.toml $table.$key" "edit lib/codex-owned-keys.txt then chezmoi apply"
  done
}

operator_persona() { # the persona selection we own when the operatorPersona key is set
  local data want home have
  data="$("${CZ[@]}" data --format json 2>/dev/null)" || return 0
  want="$(jq -r '.operatorPersona // empty' <<<"$data")"
  [ -n "$want" ] || return 0
  home="$("$REPO/lib/operator-persona.sh" --home "$(jq -r '.operatorHome // empty' <<<"$data")")" || return 0
  have="$(head -n 1 "$home/config/po-theme" 2>/dev/null || true)"
  have="${have:-nautical}"
  [ "$have" = "$want" ] && return 0
  emit owned-key "$home/config/po-theme" "set operatorPersona in ~/.config/chezmoi/chezmoi.toml to $have, or lib/operator-persona.sh $(printf '%q %q' "$want" "$home")"
}

agent_plugins() { # crew and its packs for Claude Code, Codex and pi, unless agentPlugins = false
  [ -x "$REPO/lib/agent-plugins.sh" ] || return 0
  [ "$("${CZ[@]}" data --format json 2>/dev/null | jq -r '.agentPlugins')" = false ] && return 0
  "$REPO/lib/agent-plugins.sh" check
}

packages() {
  local data listed pkg sets
  # The same chezmoi init answers the brew-bundle script follows: with installTarget = distrobox
  # the host installs nothing, and toolsets (or, before re-init, opsTools = true for all) turns on
  # sets from lib/toolsets.txt. A tool from any set counts as listed, so one installed by hand or
  # left by a set turned off is never pkg-extra; only the sets that are on can be pkg-missing.
  data="$("${CZ[@]}" data --format json 2>/dev/null)"
  if [ "$(jq -r '.installTarget // empty' <<<"$data" 2>/dev/null)" = distrobox ]; then
    [ -e "${DOTFILES_CONTAINER_MARKER:-/run/.containerenv}" ] || return 0
  fi
  sets="$(jq -r 'if has("toolsets") then [.toolsets[]? | tostring] | join(",") elif .opsTools == true then "all" else "" end' <<<"$data" 2>/dev/null)"
  listed="$(HOMEBREW_DOTFILES_TOOLSETS=all brew bundle list --all --file="$REPO/Brewfile" 2>/dev/null)"
  { brew leaves --installed-on-request 2>/dev/null; brew list --cask 2>/dev/null; } | sort -u |
    while IFS= read -r pkg; do
      [ -z "$pkg" ] && continue
      grep -qxF "$pkg" <<<"$listed" && continue
      drift_ignored "$pkg" && continue
      emit pkg-extra "$pkg" "add to Brewfile, or skip (lib/drift-ignore.txt)"
    done
  # Homebrew prints the "needs to be installed" lines on stderr.
  HOMEBREW_DOTFILES_TOOLSETS="$sets" brew bundle check --verbose --no-upgrade --file="$REPO/Brewfile" 2>&1 |
    sed -nE 's/^→ (Formula|Cask) (.+) needs to be installed.*/\2/p' |
    while IFS= read -r pkg; do
      emit pkg-missing "$pkg" "${sets:+HOMEBREW_DOTFILES_TOOLSETS=$sets }brew bundle --file=$REPO/Brewfile"
    done
}

untracked() {
  local managed dir path
  managed="$("${CZ[@]}" managed --include files 2>/dev/null)"
  for dir in "${WATCHED_DIRS[@]}"; do
    [ -d "$HOME/$dir" ] || continue
    find "$HOME/$dir" \( -type f -o -type l \) 2>/dev/null | while IFS= read -r path; do
      path="${path#"$HOME"/}"
      grep -qxF "$path" <<<"$managed" && continue
      denylisted "$path" && continue
      chezmoi_ignored "$path" && continue
      emit untracked-config "$path" "chezmoi add ~/$path"
    done
  done
}

findings="$({ edited; owned_keys; ptyxis_keys; zshrc_line; codex_keys; operator_persona; agent_plugins; packages; untracked; } 2>/dev/null)"

case "${1:-}" in
  --summary)
    [ -n "$findings" ] && echo "dotfiles: $(grep -c . <<<"$findings") changes not codified - run /codify"
    ;;
  --hook)
    [ -n "$findings" ] && jq -n --arg m "dotfiles: $(grep -c . <<<"$findings") changes not codified - run /codify" '{systemMessage: $m}'
    ;;
  --json)
    jq -Rn '[inputs | select(length > 0) | split("\t") | {kind: .[0], target: .[1], action: .[2]}]' <<<"$findings"
    ;;
  *)
    [ -n "$findings" ] && printf '%s\n' "$findings"
    ;;
esac
exit 0
